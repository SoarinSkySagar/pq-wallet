{
  "expo": {
    "name": "Leafguard",
    "slug": "leafguard",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "dev.leafguard.wallet"
    },
    "android": {
      "package": "dev.leafguard.wallet",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Leafguard uses the camera to scan pairing and address QR codes.",
          "recordAudioAndroid": false
        }
      ]
    ]
  }
}
